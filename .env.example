# Copy this file to .env and fill in your values. .env is not committed.

# Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# No example value on purpose: it would be too easy to copy into production.
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite for local development, PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://crm:crm@localhost:5432/crm
DATABASE_URL=sqlite:///./crm.db

# Frontend origins allowed to call the API, comma separated. Not "*":
# browsers reject "*" together with credentials.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Public demo: show demo logins on the sign-in page and reset the data
# every DEMO_RESET_HOURS. Never enable this on a database with real data.
DEMO_MODE=false
DEMO_RESET_HOURS=6

# Who may embed the app in an <iframe>, e.g. 'self' https://your-portfolio.example
FRAME_ANCESTORS='self'
